# Paste into Coolify → project → Environment Variables (compose: deploy/docker-compose.yml).
# Secrets are placeholders — set them as "secret" variables in Coolify, never in git.

# --- chain: leave RPC_URL unset to use the bundled anvil (throwaway; redeploys on restart) ---
RPC_URL=
DEPLOYER_PRIVATE_KEY=
BORROWER_ADDRESS=
# Sepolia only: reuse the canonical Aqua registry; verify PoolManager/WETH on docs.uniswap.org first.
AQUA=
POOL_MANAGER=
WETH=

# --- operator API ---
API_KEY=<random ≥24 chars>
SEED=true

# --- dashboard (build args: rebuild when they change) ---
NEXT_PUBLIC_GATEWAY_URL=https://<api domain in Coolify>
NEXT_PUBLIC_GATEWAY_KEY=<same value as API_KEY>

# --- Curvegrid MultiBaas (only meaningful on a chain it supports) ---
MULTIBAAS_URL=https://opslmgbu45agbhyjtipksqjxoq.multibaas.com
MULTIBAAS_API_KEY=
