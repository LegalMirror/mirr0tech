# Coolify: Build Pack = Dockerfile, Dockerfile location `deploy/Dockerfile.api`, Base directory `/`.
# Remote startup reuses the committed Sepolia deployment; it does not deploy or seed a new stack.
# Keep runtime secrets in Coolify and mount DATA_DIR so agreements, audits and bindings persist.
ARG NODE_VERSION=22-bookworm-slim

# ── foundry (anvil is only needed when no RPC_URL is given) ────────────────
FROM ghcr.io/foundry-rs/foundry:latest AS foundry

# ── build: compile all three policy profiles into artifacts/ ──────────────
FROM node:${NODE_VERSION} AS build
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY dashboard/package.json dashboard/
RUN pnpm install --frozen-lockfile
COPY . .
RUN sh scripts/vendor.sh \
 && node scripts/compile.js --demo && node scripts/build-contracts.js \
 && node scripts/compile.js --secondary --demo && node scripts/build-contracts.js \
 && node scripts/compile.js --mla --demo && node scripts/build-contracts.js

# ── run ─────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3200 HOST=0.0.0.0 \
    EXPECTED_CHAIN_ID=11155111 DEPLOYMENT_PATH=deployments/sepolia.json \
    DATA_DIR=/app/.data SEED=false PUBLIC_DEMO=true MOCK_DELIBERATION_SECONDS=12
COPY --from=foundry /usr/local/bin/anvil /usr/local/bin/anvil
COPY --from=build --chown=node:node /app /app
RUN chmod +x deploy/api-entrypoint.sh && mkdir -p /app/.data && chown node:node /app/.data
# The entrypoint starts as root only to chown the mounted data directory, then runs everything as node.
EXPOSE 3200
# Coolify swaps traffic only once the API has finished binding the existing stack.
HEALTHCHECK --interval=10s --timeout=3s --start-period=120s --retries=12 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3200)+'/health',{signal:AbortSignal.timeout(2000)}).then(r=>{if(!r.ok)console.error('health HTTP',r.status);process.exit(r.ok?0:1)}).catch(e=>{console.error('health request failed:',e.cause?.code||e.name);process.exit(1)})"
ENTRYPOINT ["sh", "deploy/api-entrypoint.sh"]
CMD []
