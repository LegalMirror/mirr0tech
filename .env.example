# The API is an operator API; every /v1 route requires this bearer token.
API_KEY=replace-with-a-long-random-local-secret
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
POLICY_PATH=generated/policy.json
# mock is a persistent local simulation; evm uses the actual Solidity contract.
CHAIN_MODE=mock
# EVM mode is intentionally limited to a local development chain (31337).
RPC_URL=http://127.0.0.1:8545
TOKEN_ADDRESS=
MINTER_PRIVATE_KEY=
# Live extraction is optional. The demo never calls an LLM.
OPENAI_API_KEY=
# Noolog deliberation (https://api.peeramid.xyz): agents verify every claim of an extraction. Without a key the
# in-process mock orchestrator runs the same routes with no model behind it.
NOOLOG_URL=https://api.peeramid.xyz
NOOLOG_API_KEY=
# The legal RWA policy (seats RwaCounsel + RwaScrivener + RwaCompliance, 3 rounds); nsed:deep is the generic pair. The account needs credits.
NOOLOG_MODEL=nsed:legal_rwa_pro
# Which engine reads an agreement: noolog | mock | openai (unset: follows the keys present, mock last).
EXTRACTOR=
# The bypass: one model call on any OpenAI-compatible endpoint (Astra, OpenAI, a local server), no deliberation and no verdicts.
# EXTRACTOR=openai OPENAI_BASE_URL=https://<astra host>/v1 OPENAI_API_KEY=<astra key> OPENAI_MODEL=<astra model>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL=gpt-6-astra

# Two-act stack deployment (scripts/deploy-stack.js). Local anvil needs nothing set.
# On Sepolia set the deployer key and reuse the canonical venue contracts instead of redeploying:
#   AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a   # 1inch Aqua registry, same address on every supported chain
#   POOL_MANAGER=<Uniswap v4 PoolManager on Sepolia>   # verify on docs.uniswap.org before use
#   WETH=<WETH on Sepolia>                             # verify before use
# The SwapVM router is always ours (custom opcodes); the rules allow a modified SwapVM redeploy.
DEPLOYER_PRIVATE_KEY=
BORROWER_ADDRESS=
AQUA=
POOL_MANAGER=
WETH=

# World ID: a document credential becomes the identityVerified fact. Register an app at developer.world.org;
# without WORLD_RP_ID the gateway runs a mock verifier that accepts well-formed mock proofs.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=onboard-investor
WORLD_CREDENTIAL=document   # document (Passport/NFC) | proof_of_human | selfie
WORLD_ENVIRONMENT=staging

# Curvegrid MultiBaas: registers the deployed contracts for indexing, event queries and the explorer.
MULTIBAAS_URL=https://opslmgbu45agbhyjtipksqjxoq.multibaas.com
MULTIBAAS_API_KEY=
# Index from this block when linking (absolute, or relative like -100; the dev plan caps the depth).
MULTIBAAS_STARTING_BLOCK=-100
# SIGNER=multibaas signs from a MultiBaas Cloud Wallet (HSM) instead of DEPLOYER_PRIVATE_KEY; MULTIBAAS_WALLET picks it when several exist.
SIGNER=
MULTIBAAS_WALLET=

# Payment rail webhook (Stripe signature scheme): POST /webhooks/payments settles USD payments into shares.
PAYMENT_WEBHOOK_SECRET=
