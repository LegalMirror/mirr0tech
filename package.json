{
  "name": "mirrortech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Legal documents to executable RWA mint and redemption policies",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "extract": "node scripts/extract.js",
    "compile": "node scripts/compile.js",
    "build": "node scripts/compile.js --demo && node scripts/build-contracts.js",
    "build:contracts": "node scripts/build-contracts.js",
    "deploy": "node scripts/deploy.js",
    "test": "node --test test/*.test.js",
    "test:chain": "node --test test/chain/*.test.js",
    "check": "npm test && npm run build && npm run test:chain"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ajv": "8.20.0",
    "dotenv": "17.3.1",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "html-to-text": "9.0.5"
  },
  "overrides": { "tmp": "0.2.7" },
  "devDependencies": {
    "solc": "0.8.37"
  }
}
