# pnpm start serves the persistent local workspace. OPENAI_API_KEY enables file AST generation.
WORKSPACE_DIR=.data/workspace
EXPECTED_CHAIN_ID=11155111
DEPLOYMENT_PATH=deployments/sepolia.json
# API_KEY is for the separate hosted/legacy operator API.
API_KEY=replace-with-a-long-random-local-secret
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data
POLICY_PATH=generated/policy.json
# mock is a persistent local simulation; evm uses the actual Solidity contract.
CHAIN_MODE=mock
# Optional Sepolia RPC for workspace deployment. Leave blank for uploads and generation only.
RPC_URL=
TOKEN_ADDRESS=
MINTER_PRIVATE_KEY=
# Live extraction is optional. The demo never calls an LLM.
OPENAI_API_KEY=
# Light analysis uses reasoning.effort=none. Keys remain on the server.
OPENAI_MODEL=gpt-5.4-mini
# Request + response-body deadline in ms (default 5 minutes; maximum 1 hour).
OPENAI_TIMEOUT_MS=300000
# Noolog deliberation (https://api.peeramid.xyz): choose generation "noolog" per upload, or EXTRACTOR=noolog as the default.
# The legal RWA policy (seats RwaCounsel + RwaScrivener + RwaCompliance, 3 rounds); nsed:deep is the generic pair. The account needs credits.
NOOLOG_URL=https://api.peeramid.xyz
NOOLOG_API_KEY=
NOOLOG_MODEL=nsed:legal_rwa_pro
EXTRACTOR=

# Explicit two-act stack deployment (scripts/deploy-stack.js); pnpm start reuses Sepolia.
# On Sepolia set the deployer key and reuse the canonical venue contracts instead of redeploying:
#   AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a   # 1inch Aqua registry, same address on every supported chain
#   POOL_MANAGER=<Uniswap v4 PoolManager on Sepolia>   # verify on docs.uniswap.org before use
#   WETH=<WETH on Sepolia>                             # verify before use
# The SwapVM router is always ours (custom opcodes); the rules allow a modified SwapVM redeploy.
# Use either key. DEPLOYER_PRIVATE_KEY takes precedence when both are set.
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=
BORROWER_ADDRESS=
AQUA=
POOL_MANAGER=
WETH=

# World ID: a document credential becomes the identityVerified fact. Register an app at developer.world.org;
# without WORLD_RP_ID the gateway runs a mock verifier that accepts well-formed mock proofs.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=onboard-investor
WORLD_CREDENTIAL=document   # document (Passport/NFC) | proof_of_human | selfie
WORLD_ENVIRONMENT=sandbox


# Payment rail webhook (Stripe signature scheme): POST /webhooks/payments settles USD payments into shares.
PAYMENT_WEBHOOK_SECRET=

# Application login (Node 22.13+). Uses WORLD_APP_ID / WORLD_RP_ID / WORLD_RP_SIGNING_KEY.
# Mock login is the default; sandbox mode requires the credentials above. Persist the database on the backend data volume.
WORLD_SESSION_DB=.data/world-sessions.sqlite

# Application login: mock (placeholder), sandbox (v4), or v3 (staging simulator).
# Required in v3 mode: exact registered action name, separate from WORLD_ACTION.
WORLD_LOGIN_ACTION=login
