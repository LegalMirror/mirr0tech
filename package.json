{
  "name": "mirrortech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Legal documents to executable RWA mint and redemption policies",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "extract": "node scripts/extract.js",
    "compile": "node scripts/compile.js",
    "build": "node scripts/compile.js --demo && node scripts/build-contracts.js",
    "build:contracts": "node scripts/build-contracts.js",
    "deploy": "node scripts/deploy.js",
    "test": "node --test test/*.test.js",
    "test:chain": "node --test test/chain/credit.test.js test/chain/swapvm.test.js test/chain/hook.test.js",
    "check": "npm test && npm run build && npm run build:secondary && npm run test:chain:rwa && npm run build:credit && npm run test:chain && npm run test:chain:stack",
    "build:credit": "npm run vendor --silent && node scripts/compile.js --mla --demo && node scripts/build-contracts.js",
    "demo:credit": "npm run build:credit --silent && node scripts/demo-credit.js",
    "test:chain:rwa": "node --test test/chain/evm.test.js test/chain/rwa-pool.test.js",
    "vendor": "sh scripts/vendor.sh",
    "ui:export": "node scripts/export-ui.js",
    "build:secondary": "node scripts/compile.js --secondary --demo && node scripts/build-contracts.js",
    "deploy:stack": "node scripts/deploy-stack.js",
    "test:chain:stack": "node --test test/chain/stack.test.js",
    "demo:golden": "node scripts/demo-golden.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/v4-core": "^1.0.2",
    "ajv": "8.20.0",
    "dotenv": "17.3.1",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "html-to-text": "9.0.5"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@1inch/aqua-sdk": "^0.3.4",
    "@1inch/solidity-utils": "^6.9.7",
    "@1inch/swap-vm-sdk": "^0.4.4",
    "solc": "0.8.37",
    "solc-swapvm": "npm:solc@^0.8.30",
    "solc-v4": "npm:solc@^0.8.26",
    "solmate": "^6.8.0"
  }
}
