# Paste into Coolify → project → Environment Variables (compose: deploy/docker-compose.yml).
# Secrets are placeholders — set them as "secret" variables in Coolify, never in git.

# --- chain: leave RPC_URL unset to use the bundled anvil (throwaway; redeploys on restart) ---
RPC_URL=
DEPLOYER_PRIVATE_KEY=
# PRIVATE_KEY is an alternative; DEPLOYER_PRIVATE_KEY takes precedence.
PRIVATE_KEY=
BORROWER_ADDRESS=
# Sepolia: reuse the committed record (no redeploy on restart) and the canonical venues.
# DEPLOYMENT_PATH=deployments/sepolia.json
# AUDIT_PATH=deployments/sepolia-audit.json   # the seeded golden path; with SEED=false nothing is re-sent
# AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
# POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# WETH=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
DEPLOYMENT_PATH=
AUDIT_PATH=
AQUA=
POOL_MANAGER=
WETH=

# --- operator API ---
API_KEY=<random ≥24 chars>
# Read-only token for a public dashboard build (GET routes only).
VIEWER_KEY=<random ≥24 chars, not API_KEY>
SEED=true

# --- dashboard (build args: rebuild when they change) ---
NEXT_PUBLIC_GATEWAY_URL=https://<api domain in Coolify>
NEXT_PUBLIC_GATEWAY_KEY=<VIEWER_KEY for a public build; API_KEY only for the operator's own build>

# Sandbox application login: backend-only Portal credentials.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=sandbox
WORLD_SESSION_DB=/app/.data/world-sessions.sqlite

# Placeholder application login; sandbox restores QR proofs.
# v3 selects simulator.worldcoin.org; supply the exact registered login action.
WORLD_LOGIN_ACTION=
# Staging/sandbox proofs verify only inside a window opened in the Developer Portal (Portal MCP set_world_id_staging_verification); its token goes here.
WORLD_STAGING_VERIFICATION_TOKEN=
